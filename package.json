{
  "name": "yanhe-refine",
  "version": "0.10.5",
  "private": true,
  "type": "module",
  "description": "延河焕新：直接在延河课堂原站整合导航、课程、直录播、资料与待办。",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/site-browser-test.mjs",
    "test:browser:mode": "node tools/site-mode-browser-test.mjs",
    "test:fixtures": "node tools/generate-fixtures.mjs",
    "catalog": "python tools/prepare-catalog.py",
    "package": "python tools/package.py",
    "test:browser:index": "node tools/index-browser-test.mjs",
    "test:browser:self-index": "node tools/self-index-browser-test.mjs",
    "test:browser:layout": "node tools/viewer-layout-browser-test.mjs",
    "test:browser:live-features": "node tools/live-features-browser-test.mjs",
    "test:browser:streams": "node tools/three-stream-browser-test.mjs",
    "test:browser:imports": "node tools/catalog-import-browser-test.mjs",
    "test:browser:metadata": "node tools/metadata-browser-test.mjs",
    "test:browser:tasks": "node tools/tasks-browser-test.mjs"
  },
  "dependencies": {
    "blueimp-md5": "2.19.0",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  }
}
